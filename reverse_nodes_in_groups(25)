/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    ListNode start=null;
    public ListNode recurse(ListNode head,ListNode prev,ListNode con,int k,int count)
    {
        if(head==null)
           return null;
        if(k==count)
        {
            if(start==null)
               start=head;
            else
               con.next=head;
            ListNode node=head.next;
            head.next=prev;
            if(node==null)
               return new ListNode(1001);
            return node;
        }
        ListNode node=recurse(head.next,head,con,k,count+1);
        if(node==null)
           return null;
        if(count==1)
        {
            if(node.val!=1001)
               head.next=node;
            else
               head.next=null;
        }
        else
           head.next=prev;
        return node;
    }
    public ListNode reverseKGroup(ListNode head, int k) {
        //1->2->3->4->5->6->7->8->9
        //3->2->1->6->5->4->9->8->7
        if(k==1)
           return head;
        ListNode ret=head;
        ListNode temp=null;
        while(ret!=null&&ret.val!=1001)
        {
            ListNode temp1=ret;
            ret=recurse(ret,null,temp,k,1);
            temp=temp1;
        }
        return start;
    }
}