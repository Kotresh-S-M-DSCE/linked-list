/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    public int[] nodesBetweenCriticalPoints(ListNode head) {
        int count=0;
        ListNode temp=head;
        while(temp!=head&&count<2)
        {
            temp=temp.next;
            count++;
        }
        if(temp==null)
            return new int[]{-1,-1};
        List<Integer> list=new ArrayList<>();
        temp=head;
        ListNode prev=temp;
        temp=temp.next;
        ListNode cur=temp;
        temp=temp.next;
        int min=100000;
        while(temp!=null)
        {
            ListNode ahead=temp;
            if((prev.val<cur.val&&cur.val>ahead.val)||(prev.val>cur.val&&cur.val<ahead.val))
            {
                list.add(count-1);
                if((list.size()>1)&&(list.get(list.size()-1)-list.get(list.size()-2)<min))
                    min=list.get(list.size()-1)-list.get(list.size()-2);
            }
            count++;
            temp=temp.next;
            prev=cur;
            cur=ahead;
        }
        if(list.size()<2)
            return new int[]{-1,-1};
        return new int[]{min,list.get(list.size()-1)-list.get(0)};
    }
}