/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    public int[][] spiralMatrix(int m, int n, ListNode head) {
        int[][] ret=new int[m][n];
        for(int i=0;i<m;i++)
            Arrays.fill(ret[i],-1);
        ListNode temp=head;
        int i=0,j=0,k=-1,l=-1;
        while(temp!=null)
        {
            while(temp!=null&&j<n)
            {
                ret[i][j++]=temp.val;
                temp=temp.next;
            }
            if(temp==null)
                return ret;
            j--;
            i++;
            while(temp!=null&&i<m)
            {
                ret[i++][j]=temp.val;
                temp=temp.next;
            }
            i--;
            j--;
            if(temp==null)
                return ret;
            while(temp!=null&&j>k)
            {
                ret[i][j--]=temp.val;
                temp=temp.next;
            }
            if(temp==null)
                return ret;
            j++;
            i--;
            l++;
            while(temp!=null&&i>l)
            {
                ret[i--][j]=temp.val;
                temp=temp.next;
            }
            i++;
            j++;
            n--;
            k++;
            m--;
        }
        return ret;
    }
}